# Server
PORT=3000
NODE_ENV=development

# Database SQLite
DB_PATH=./data/pharmapuglia.db

# Autenticazione JWT (impostare una stringa casuale sicura nel proprio .env locale)
JWT_SECRET=change-me-with-a-random-secret
JWT_EXPIRES_IN=24h

# OpenStreetMap / Nominatim (User-Agent richiesto dalla usage policy pubblica)
NOMINATIM_USER_AGENT=PharmaPugliaOpenCare/1.0 (progetto-accademico-mmqs)
