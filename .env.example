# Server
PORT=3000
NODE_ENV=development

# Database SQLite
DB_PATH=./data/pharmapuglia.db

# Autenticazione JWT (obbligatorio: almeno 32 caratteri casuali nel proprio .env locale).
# Il valore qui sotto viene rifiutato di proposito. Per generarne uno:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-with-a-random-secret
JWT_EXPIRES_IN=24h

# OpenStreetMap / Nominatim (User-Agent richiesto dalla usage policy pubblica)
NOMINATIM_USER_AGENT=PharmaPugliaOpenCare/1.0 (progetto-accademico-mmqs)
